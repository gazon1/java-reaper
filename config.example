# Конфигурация java-reaper.
# Файл: ~/.config/java-reaper/config   (KEY=VALUE, # — комментарий)
# Все значения опциональны: отсутствующие берутся из встроенных дефолтов.

# Порог простоя Gradle-демона, после которого он считается «забытым».
# 21600 = 6 ч. ВАЖНО: это ВЫШЕ собственного idle-таймаута Gradle
# (idleTimeout=10800000 мс = 180 мин): Gradle убивает демона сам, ровно
# через 180 мин простоя. Наш порог должен быть выше, иначе мы конкурируем
# с Gradle за одни и те же демоны и проигрываем — к моменту свипа демон
# уже мёртв.
#
# Ниже 3 ч опускаться нельзя (ретроспективно по 8291 простою между
# сборками): 60 мин → 88.5 % ложных срабатываний, 90 мин → 92.9 %,
# 120 мин → 100 %. При 6 ч остаются только «зависшие» демоны (клиент
# отвалился во время сборки — Gradle их не убирает): 3 из 893 за всю
# историю, и все три — именно такие.
IDLE_SECONDS=21600

# Порог простоя Kotlin-демона (секунды). 7200 = 2 ч.
# Отдельный порог, потому что у Kotlin-демона СВОЕГО idle-таймаута нет:
# он умирает только по «No more clients left» — то есть его не убирает
# никто. Это и есть настоящая цель рейпера.
# 2 ч — заведомо выше «живого» простоя: между сессиями компиляции
# p99 = 16 мин, p99.9 = 100.6 мин, максимум 1.7 ч.
KOTLIN_IDLE_SECONDS=7200

# Через сколько после отмены сборки демон считается «зависшим».
# Отдельный порог, потому что это ДРУГАЯ категория: клиент отвалился во
# время сборки — работать некому, и работать уже некому. Gradle такой
# демон не убирает (его idle-таймаут не действует, пока демон «в сборке»).
# Измерено: из 80 таких демонов медиана жизни после отмены — 2 мин, но
# единицы живут часами (максимум 5.8 ч) — их и ловим.
STUCK_AFTER_SECONDS=3600

# Защита Kotlin-демонов действует, пока сборка Gradle идёт «по-настоящему»
# (началась недавно). Сборка, начавшаяся несколько часов назад и не
# завершившаяся, — это зависший демон, а не идущая работа; иначе один
# зависший Gradle-демон блокировал бы уборку Kotlin-навсегда.
GRADLE_BUILD_ACTIVE_SECONDS=1800

# RSS+swap (МБ) ниже этого — не жалко пересоздать демона.
MIN_FOOTPRINT_MB=128

# Давление по памяти: сколько свободной памяти (МБ) считается «мало».
# Ниже этого порога машине память реально нужна, и простаивающие демоны
# подлежат уборке. Выше — памяти хватает, и рейпер не трогает демонов
# поменьше KILL_LARGE_DAEMON_MB: убивать их — платить холодным стартом
# без выгоды.
# Источник: MemAvailable из /proc/meminfo (с учётом кеша, который можно
# вытеснить без обмена — это честнее, чем MemFree).
# 0 = «всегда убирать» (безусловная чистка, минус выгода).
MEMORY_PRESSURE_MB=4096

# Демон крупнее этого (МБ) убирается в любом случае: столько памяти жалко
# держать простаивающим, даже когда система не напряжена.
KILL_LARGE_DAEMON_MB=4096

# Цена ошибки: сколько секунд стоит воссоздать демона (холодный старт).
# Влияет на ПОРЯДОК уборки, а не на сам факт: сначала убирается тот, кто даёт
# больше освобождённой памяти на секунду потраченного времени.
# Измерено: Gradle — 41.6 с (холодный) против 2.4 с (тёплый);
# Kotlin дешёв — это просто старт JVM.
GRADLE_RECREATE_COST_SECONDS=40
KOTLIN_RECREATE_COST_SECONDS=5

# Сколько секунд CPU за свип считается «работает» (шум health-check'а — 21–33 тика).
BUSY_CPU_SECONDS=3.0

# Интервал свипа (должен совпадать с OnUnitActiveSec таймера).
SWEEP_SECONDS=300

# Пауза между SIGTERM и SIGKILL.
GRACE_SECONDS=15

# Сколько неудачных SIGTERM допускаем перед эскалацией до SIGKILL (только Gradle).
GRADLE_SIGKILL_AFTER_TRIES=3

# Сколько демонов максимум убивать за один свип — страховка от массовой ошибки
# правил. 0 = без ограничения (не рекомендуется).
MAX_KILLS_PER_SWEEP=3

# После скольких часов Established-соединение перестаёт считаться наблюдателем
# (зависший клиент). Защита от «вечных» демонов, к которым подключён мёртвый IDE.
PEER_MAX_AGE_SECONDS=21600

# Окно наблюдения за «would kill»: если демон понадобился снова в течение этого
# времени — считаем ложным срабатыванием.
# 6 ч, а не 2 ч: измерено, что демон возвращается с лагом p50 = 0.2 ч,
# p90 = 6.4 ч, max = 25.1 ч. При окне 2 ч мы видели бы лишь 61 %
# возвратов (4 ч — 67 %, 8 ч — 97 %) и занижали долю ложных
# срабатываний почти вдвое.
REUSE_WINDOW_SECONDS=21600

# Детекция деградации: если измерить удаётся меньше половины демонов
# (все ушли в «неизвестная история» / «нет baseline»), рейпер, скорее
# всего, слеп — и молчит, а выглядит здоровым. Раньше это замечалось
# только при нуле демонов вообще.
DEGRADATION_MIN_MEASURED_RATIO=0.5
DEGRADATION_MIN_COUNT_RATIO=0.5

# Критерий перехода из dry-run в kill-режим: сколько событий нужно набрать
# и какая доля «понадобился снова» допустима.
# Порог событий снижен с 15 до 8: при новых порогах события Gradle-стороны
# редки по замыслу (3 из 893), основной вклад даёт Kotlin.
PILOT_MIN_EVENTS=8
PILOT_MAX_REUSE_RATE=0.60

# Прицельный режим: пусто — можно убивать любого демона; перечислить PID
# через запятую — убивать только их. Нужен для первого боевого прогона.
PID_ALLOWLIST=

# Предел размера лога демона, который рейпер прочитывает целиком при первом
# свипе (дальше — инкрементально, только новые байты). Нужен потому, что
# простаивающий Gradle-демон пишет в лог DEBUG-спам (~124 Б/с), и маркеры
# сборки уезжают далеко назад: за 9 часов простоя лог перерастает 4 МБ.
LOG_SCAN_MAX_BYTES=536870912

# Усекать ли логи простаивающих Gradle-демонов (1 = да). Простаивающий демон
# пишет в лог ~10 МБ в сутки; уровнем логирования это НЕ лечится (проверено:
# прирост одинаков при default/info/lifecycle). Логи Kotlin-демонов не трогаем:
# у них mtime лога — сам признак простоя.
# Мёртвые логи убирает отдельный инструмент: tools/prune-logs.py
# (по умолчанию — dry-run, удаление только по --apply).
TRIM_IDLE_LOGS=0
TRIM_AFTER_SECONDS=3600

# Аварийный тормоз: если этот файл существует, рейпер ничего не делает.
DISABLED_FLAG=~/.config/java-reaper/disabled
