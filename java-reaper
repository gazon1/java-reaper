# Константы
# --------------------------------------------------------------------------- #

GRADLE_MAIN = "org.gradle.launcher.daemon.bootstrap.GradleDaemon"
KOTLIN_MAIN = "org.jetbrains.kotlin.daemon.KotlinCompileDaemon"

DEFAULTS: dict[str, Any] = {
    "IDLE_SECONDS": 10800,        # 3 ч — порог простоя
    "MIN_FOOTPRINT_MB": 128,      # RSS+swap ниже — не жалко
    "BUSY_CPU_SECONDS": 3.0,      # 3 с CPU за свип = «занят»
    "SWEEP_SECONDS": 300,         # интервал свипа
    "GRACE_SECONDS": 15,          # SIGTERM → пауза → SIGKILL
    "GRADLE_SIGKILL_AFTER_TRIES": 3,
    "REUSE_WINDOW_SECONDS": 7200,  # окно «понадобился снова» для метрики
    "LOG_SCAN_MAX_BYTES": 512 * 1024 * 1024,  # предел полного разбора лога
    "STATE_DIR": "~/.local/state/java-reaper",
    "CONFIG_PATH": "~/.config/java-reaper/config",
    "LOCK_PATH": "~/.local/state/java-reaper/reaper.lock",
}

# Дети, которые не считаются «работой» и потому не защищают протухший демон.
# Сопоставляется ТОЛЬКО имя исполняемого файла: поиск подстроки по всему
# cmdline ловил classpath-пути вроде «…playwright-1.49.0.jar» и ошибочно
# объявлял шумом реально работающий fork приложения.
CHILD_IGNORE_EXECUTABLES = frozenset({
    "adb", "node", "nodejs", "python", "python2", "python3", "ollama", "mcp",
    "playwright", "chrome", "chromium", "google-chrome", "chromium-browser",
})

# Маркеры в логе Gradle-демона.
#   «Received command: Build»     — INFO, начало сборки.
#   «Marking the daemon as idle»  — INFO, демон освободился (1:1 со сборкой).
# Второй маркер надёжнее «after build finished»: тот — DEBUG-уровень и
# исчезает, когда DEBUG-логирование выключено.
MARK_BUILD_START = "Received command: Build"
MARK_BUILD_END = "Marking the daemon as idle"
MARK_BUILD_END_ALT = "after build finished"

TS_RE = re.compile(
    r"^(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d[.,]\d+(?:[+-]\d{2}:?\d{2}|Z)?)")


# --------------------------------------------------------------------------- #
# Утилиты
# --------------------------------------------------------------------------- #

def expand(path: str) -> str:
    return os.path.abspath(os.path.expanduser(path))


def load_config(path: str | None) -> dict[str, Any]:
    cfg = dict(DEFAULTS)
    cfg_path = expand(path or DEFAULTS["CONFIG_PATH"])
    if os.path.isfile(cfg_path):
        with open(cfg_path, encoding="utf-8") as fh:
            for raw in fh:
                line = raw.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, value = line.split("=", 1)
                key = key.strip()
                value = value.split("#", 1)[0].strip()
                if key not in DEFAULTS:
                    continue
                default = DEFAULTS[key]
                try:
                    cfg[key] = type(default)(value) if not isinstance(default, bool) else value.lower() in ("1", "true", "yes")
                except (TypeError, ValueError):
                    pass
    return cfg


def parse_ts(token: str) -> float | None:
    """Разбор ISO-таймстампа лога Gradle в epoch.

    Смещение часов из лога учитывается: «2026-10-04T12:00:00.000+0300» — это
    09:00 UTC. Иначе сравнение с локальным временем сломается при смене
    таймзоны (и логи разных демонов могут быть с разными смещениями).
    """
    m = TS_RE.match(token.strip())
    if not m:
        return None
    iso = m.group(1).replace(",", ".")
    try:
        return datetime.fromisoformat(iso).timestamp()
    except ValueError:
        return None


def read_proc_stat(pid: int) -> dict[str, Any] | None:
    try:
        with open(f"/proc/{pid}/stat", encoding="utf-8") as fh:
            raw = fh.read()
    except OSError:
        return None
    try:
        fields = raw[raw.rindex(")") + 2:].split()
    except ValueError:
        return None
    if len(fields) < 22:
        return None
    return {
        "state": fields[0],
        "ppid": int(fields[1]),
        "utime": int(fields[11]),
        "stime": int(fields[12]),
        "starttime": int(fields[19]),
    }


def read_memory(pid: int) -> tuple[int, int]:
    """(VmRSS, VmSwap) в КБ. zram-счёт важен: часть страниц вытеснена в swap."""
    rss = swap = 0
    try:
        with open(f"/proc/{pid}/status", encoding="utf-8") as fh:
            for line in fh:
                if line.startswith("VmRSS:"):
                    rss = int(line.split()[1])
                elif line.startswith("VmSwap:"):
                    swap = int(line.split()[1])
    except (OSError, ValueError):
        pass
    return rss, swap


def proc_cmdline(pid: int) -> str:
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as fh:
            return fh.read().decode("utf-8", "replace").replace("\0", " ").strip()
    except OSError:
        return ""


def daemon_kind(cmdline: str) -> str | None:
    if GRADLE_MAIN in cmdline:
        return "gradle"
    if KOTLIN_MAIN in cmdline:
        return "kotlin"
    return None


def find_log_path(pid: int) -> str | None:
    """Путь к логу демона — точно, через открытые дескрипторы.

    Gradle держит свой daemon-<pid>.out.log на stdout, Kotlin — свой
    kotlin-daemon.*.log. Никаких эвристик по времени старта.
    """
    fddir = f"/proc/{pid}/fd"
    try:
        fds = os.listdir(fddir)
    except OSError:
        return None
    for fd in fds:
        try:
            target = os.readlink(os.path.join(fddir, fd))
        except OSError:
            continue
        if not target.endswith(".log"):
            continue
        base = os.path.basename(target)
        if base.startswith("daemon-") and base.endswith(".out.log"):
            return target
        if base.startswith("kotlin-daemon."):
            return target
    return None


def _scan_markers(text: str) -> tuple[float | None, float | None]:
    """Последние таймстемпы старта и конца сборки в блоке текста."""
    last_start = last_end = None
    for line in text.splitlines():
        if MARK_BUILD_START in line:
            ts = parse_ts(line)
            if ts is not None:
                last_start = ts
        elif MARK_BUILD_END in line or MARK_BUILD_END_ALT in line:
            ts = parse_ts(line)
            if ts is not None:
                last_end = ts
    return last_start, last_end


def scan_gradle_log(path: str, offset: int, max_bytes: int) -> dict[str, Any]:
    """Разбор лога Gradle-демона.

    Логи демонов засоряются DEBUG-спамом («Waiting to acquire shared lock on
    daemon addresses registry»): простаивающий демон пишет в лог постоянно.
    Поэтому mtime лога не признак активности, а маркеры сборки уезжают
    далеко назад и обычное чтение хвоста их теряет.

    Схема: первое чтение — от начала файла (маркеры нужны самые новые, а
    файл прочитан целиком => точность максимальная); дальше — только новые
    байты, смещение хранится в состоянии. Если файл больше max_bytes и в
    начале маркеры не найдены — история неизвестна (idle_known=False), и
    демон защищается.
    """
    try:
        size = os.path.getsize(path)
    except OSError:
        return {"offset": offset, "start": None, "end": None, "complete": False}
    if offset > size:
        offset = 0  # лог усечён или перезаписан
    if offset <= 0:
        if size <= max_bytes:
            start, complete = 0, True
        else:
            start, complete = size - max_bytes, False
    else:
        start, complete = offset, True
    try:
        with open(path, "rb") as fh:
            fh.seek(start)
            blob = fh.read()
    except OSError:
        return {"offset": offset, "start": None, "end": None, "complete": False}
    s, e = _scan_markers(blob.decode("utf-8", "replace"))
    if offset <= 0 and not complete and e is None:
        # Файл больше лимита и маркеры в его начале не найдены: историю
        # пока не знаем — читаем с этого места дальше в следующих свипах.
        new_offset = start
    else:
        new_offset = size
    return {"offset": new_offset, "start": s, "end": e,
            "complete": complete or e is not None}


def parse_gradle_log(path: str, tail_bytes: int) -> tuple[float | None, float | None]:
    """Совместимая обёртка: разбор лога целиком (для тестов и разовых нужд)."""
    res = scan_gradle_log(path, 0, tail_bytes)
    return res["start"], res["end"]


def tcp_table() -> dict[str, tuple[int, int, str]]:
    """inode → (local_port, remote_port, state) по /proc/net/tcp{,6}."""
    table: dict[str, tuple[int, int, str]] = {}
    for path in ("/proc/net/tcp", "/proc/net/tcp6"):
        try:
            with open(path, encoding="utf-8") as fh:
                lines = fh.read().splitlines()[1:]
        except OSError:
            continue
        for line in lines:
            f = line.split()
            if len(f) < 10:
                continue
            state = f[3]
            try:
                lport = int(f[1].rsplit(":", 1)[1], 16)
                rport = int(f[2].rsplit(":", 1)[1], 16)
            except (IndexError, ValueError):
                continue
            table[f[9]] = (lport, rport, state)
    return table


def socket_inodes(pid: int) -> set[str]:
    inodes: set[str] = set()
    fddir = f"/proc/{pid}/fd"
    try:
        fds = os.listdir(fddir)
    except OSError:
        return inodes
    for fd in fds:
        try:
            target = os.readlink(os.path.join(fddir, fd))
        except OSError:
            continue
        if target.startswith("socket:["):
            inodes.add(target[8:-1])
    return inodes


def inode_owner_map() -> dict[str, int]:
    """inode → pid для всех процессов текущего пользователя (один проход)."""
    owners: dict[str, int] = {}
    for entry in os.listdir("/proc"):
        if not entry.isdigit():
            continue
        pid = int(entry)
        fddir = f"/proc/{pid}/fd"
        try:
            fds = os.listdir(fddir)
        except OSError:
            continue
        for fd in fds:
            try:
                target = os.readlink(os.path.join(fddir, fd))
            except OSError:
                continue
            if target.startswith("socket:["):
                owners.setdefault(target[8:-1], pid)
    return owners


def children_map() -> dict[int, list[int]]:
    result: dict[int, list[int]] = {}
    for entry in os.listdir("/proc"):
        if not entry.isdigit():
            continue
        st = read_proc_stat(int(entry))
        if st is None or st["state"] == "Z":
            continue
        result.setdefault(st["ppid"], []).append(int(entry))
    return result


def is_ignored_child(cmdline: str) -> bool:
    """Считать ли ребёнка «шумом», не защищающим демона.

    Сравниваем только имя исполняемого файла. Поиск подстроки по всему
    cmdline давал ложные срабатывания: classpath форка приложения содержал
    «playwright-1.49.0.jar», и работающий процесс помечался как шум.
    """
    parts = cmdline.split()
    if not parts:
        return False
    return os.path.basename(parts[0]) in CHILD_IGNORE_EXECUTABLES


# --------------------------------------------------------------------------- #
# Модель
# --------------------------------------------------------------------------- #

@dataclass
class Daemon:
    pid: int
    kind: str
    starttime: int
    cpu_ticks: int
    rss_mb: int
    swap_mb: int
    log_path: str | None = None
    log_ok: bool = True
    idle_known: bool = True
    log_offset: int = 0
    last_build_start: float | None = None
    last_build_end: float | None = None
    log_mtime: float | None = None
    children: list[int] = field(default_factory=list)
    ignored_children: list[int] = field(default_factory=list)
    peer_pids: list[int] = field(default_factory=list)
    peer_unknown: int = 0

    @property
    def footprint_mb(self) -> int:
        return self.rss_mb + self.swap_mb

    @property
    def build_in_progress(self) -> bool:
        if self.last_build_start is None:
            return False
        if self.last_build_end is None:
            return True
        return self.last_build_start > self.last_build_end


@dataclass
class Decision:
    daemon: Daemon
    kill: bool
    reason: str
    idle_seconds: float | None = None
    last_activity: float | None = None
    busy: bool = False
    protected: bool = False


# --------------------------------------------------------------------------- #
# Сбор
# --------------------------------------------------------------------------- #

def _max_ts(*values: Any) -> float | None:
    known = [float(v) for v in values if v is not None]
    return max(known) if known else None


def collect_daemons(cfg: dict[str, Any], state: dict[str, Any]) -> list[Daemon]:
    tcp = tcp_table()
    owners = inode_owner_map()
    kids = children_map()
    prev = state.get("daemons", {})
    daemons: list[Daemon] = []
    for entry in sorted(os.listdir("/proc")):
        if not entry.isdigit():
            continue
        pid = int(entry)
        cmdline = proc_cmdline(pid)
        kind = daemon_kind(cmdline)
        if kind is None:
            continue
        st = read_proc_stat(pid)
        if st is None:
            continue
        rss, swap = read_memory(pid)
        d = Daemon(
            pid=pid,
            kind=kind,
            starttime=st["starttime"],
            cpu_ticks=st["utime"] + st["stime"],
            rss_mb=rss // 1024,
            swap_mb=swap // 1024,
        )
        rec = prev.get(str(pid)) or {}
        if rec.get("starttime") is not None and rec["starttime"] != d.starttime:
            rec = {}  # PID переиспользован — прежние накопления не про этот процесс
        d.log_path = find_log_path(pid)
        if d.log_path is None:
            d.log_ok = False
        elif kind == "gradle":
            res = scan_gradle_log(d.log_path, int(rec.get("log_offset", 0)),
                                  int(cfg["LOG_SCAN_MAX_BYTES"]))
            d.log_offset = res["offset"]
            d.idle_known = bool(res["complete"])
            d.last_build_start = _max_ts(rec.get("last_build_start"), res["start"])
            d.last_build_end = _max_ts(rec.get("last_build_end"), res["end"])
        else:
            try:
                d.log_mtime = os.path.getmtime(d.log_path)
            except OSError:
                d.log_ok = False

        for child in kids.get(pid, []):
            if is_ignored_child(proc_cmdline(child)):
                d.ignored_children.append(child)
            else:
                d.children.append(child)

        my_inodes = socket_inodes(pid)
        for ino, (lport, rport, state) in tcp.items():
            if ino not in my_inodes or state != "01":  # 01 = ESTABLISHED
                continue
            peer_inode = None
            for other, (ol, orr, ost) in tcp.items():
                if ost == "01" and ol == rport and orr == lport:
                    peer_inode = other
                    break
            if peer_inode is None:
                d.peer_unknown += 1
                continue
            owner = owners.get(peer_inode)
            if owner is None:
                d.peer_unknown += 1
            elif owner == pid:
                # Соединение с самим собой (внутренний loopback) — не наблюдатель.
                continue
            else:
                d.peer_pids.append(owner)
        daemons.append(d)
    return daemons


# --------------------------------------------------------------------------- #
# Состояние
# --------------------------------------------------------------------------- #

def state_path(cfg: dict[str, Any]) -> str:
    return os.path.join(expand(cfg["STATE_DIR"]), "state.json")


def load_state(cfg: dict[str, Any]) -> dict[str, Any]:
    try:
        with open(state_path(cfg), encoding="utf-8") as fh:
            data = json.load(fh)
    except (OSError, ValueError):
        data = {}
    data.setdefault("version", 1)
    data.setdefault("daemons", {})
    data.setdefault("would_kill", [])
    data.setdefault("metric", {"events": 0, "reused": 0})
    return data


def save_state(cfg: dict[str, Any], state: dict[str, Any]) -> None:
    path = state_path(cfg)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = f"{path}.tmp.{os.getpid()}"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(state, fh, indent=1, sort_keys=True)
        fh.flush()
        os.fsync(fh.fileno())
    os.replace(tmp, path)


# --------------------------------------------------------------------------- #
# Классификатор (чистая функция)
# --------------------------------------------------------------------------- #

def observed_activity(d: Daemon) -> float | None:
    if d.kind == "gradle":
        return d.last_build_end
    return d.log_mtime


def classify(daemons: list[Daemon], state: dict[str, Any], now: float,
             cfg: dict[str, Any]) -> list[Decision]:
    """Решает, кого убивать. Чистая функция: не трогает систему.

    Порядок: сначала локальная занятость, затем least fixed point по `watched`
    (снизу вверх), затем фильтры.
    """
    idle_limit = float(cfg["IDLE_SECONDS"])
    busy_cpu = float(cfg["BUSY_CPU_SECONDS"])
    min_foot = int(cfg["MIN_FOOTPRINT_MB"])
    sweep = float(cfg["SWEEP_SECONDS"])
    hz = os.sysconf("SC_CLK_TCK")

    known = {d.pid for d in daemons}
    prev = state.get("daemons", {})

    # --- локальные признаки -------------------------------------------------
    local: dict[int, dict[str, Any]] = {}
    for d in daemons:
        rec = prev.get(str(d.pid)) or {}
        if rec.get("starttime") is not None and rec["starttime"] != d.starttime:
            # PID переиспользован: прежняя запись не про этот процесс.
            rec = {}
        first_seen = rec.get("first_seen", now)
        last_state_activity = rec.get("last_activity") or None

        cpu_delta = None
        if "cpu_ticks" in rec:
            cpu_delta = (d.cpu_ticks - int(rec["cpu_ticks"])) / float(hz)
        log_recent = False
        if d.kind == "kotlin" and d.log_mtime is not None:
            log_recent = (now - d.log_mtime) <= sweep
        elif d.kind == "gradle" and d.last_build_end is not None:
            log_recent = (now - d.last_build_end) <= sweep

        observed = observed_activity(d)
        # Если сборка идёт (старт без конца), отсчёт простоя идёт от её старта:
        # иначе демон, чья предыдущая сборка закончилась 5 часов назад, а текущая
        # идёт уже 45 минут, выглядел бы простаивающим 5 часов.
        if d.build_in_progress and d.last_build_start is not None:
            observed = max(x for x in (observed, d.last_build_start) if x is not None)
        # Опоры простоя: только измеренная активность (лог) и наша собственная
        # история. first_seen — лишь fallback, когда активность измерить нечем:
        # иначе демон, простаивающий 10 суток, нельзя было бы убить в первые
        # сутки наблюдения.
        anchors = [x for x in (observed, last_state_activity) if x is not None]
        base = max(anchors) if anchors else first_seen
        age = now - base

        local[d.pid] = {
            "daemon": d,
            "first_seen": first_seen,
            "last_activity": base,
            "cpu_delta": cpu_delta,
            "log_recent": log_recent,
            "age": age,
            "cpu_busy": cpu_delta is not None and cpu_delta > busy_cpu,
            "has_children": bool(d.children),
            "build_in_progress": d.build_in_progress,
            "baseline_known": "cpu_ticks" in rec,
            "protected": False,
        }

    # --- least fixed point: `watched` ---------------------------------------
    # peer защищает, только если он не кандидат (клиент сборки, IDE) или сам занят.
    # Рост busy → рост watched → рост busy; берём наименьшую неподвижную точку.
    changed = True
    while changed:
        changed = False
        for pid, info in local.items():
            if info["protected"]:
                continue
            d = info["daemon"]
            for peer in d.peer_pids:
                if peer not in known:
                    info["protected"] = True
                    info["protect_reason"] = "peer: клиент сборки"
                    changed = True
                    break
                peer_info = local[peer]
                if peer_info["cpu_busy"] or peer_info["has_children"] or peer_info["protected"]:
                    info["protected"] = True
                    info["protect_reason"] = f"peer: занят (pid {peer})"
                    changed = True
                    break
            if info["protected"]:
                continue
            if d.peer_unknown:
                info["protected"] = True
                info["protect_reason"] = f"peer: {d.peer_unknown} соединение(й) с неопределённым владельцем"
                changed = True

    # --- решения ------------------------------------------------------------
    decisions: list[Decision] = []
    for pid, info in local.items():
        d = info["daemon"]
        age = info["age"]
        reason = ""
        kill = False
        busy = False
        protected = False

        if not d.log_ok:
            reason = "лог не найден — защищаю"
            protected = True
        elif not d.idle_known:
            reason = "история лога неизвестна (лог не разобран) — защищаю"
            protected = True
        elif not info["baseline_known"]:
            reason = "нет baseline (первый свип) — защищаю"
            protected = True
        elif info["protected"]:
            reason = info.get("protect_reason", "есть наблюдатель")
            protected = True
        elif info["cpu_busy"]:
            reason = f"занят: CPU {info['cpu_delta']:.1f} с за свип"
            busy = True
        elif info["has_children"]:
            reason = f"есть живые дети: {', '.join(str(c) for c in d.children)}"
            busy = True
        elif info["log_recent"]:
            reason = "лог обновлялся недавно"
            busy = True
        elif d.footprint_mb < min_foot:
            reason = f"footprint {d.footprint_mb} МБ < {min_foot} МБ"
        elif info["build_in_progress"] and age < idle_limit:
            reason = "сборка идёт (старт без конца)"
            busy = True
        elif age < idle_limit:
            reason = f"простой {age / 60:.0f} мин < {idle_limit / 60:.0f} мин"
        else:
            kill = True
            reason = (f"простой {age / 3600:.1f} ч, footprint {d.footprint_mb} МБ"
                      + (", зависшая сборка (старт без конца)" if d.build_in_progress else ""))

        decisions.append(Decision(daemon=d, kill=kill, reason=reason,
                                  idle_seconds=age, last_activity=info["last_activity"],
                                  busy=busy, protected=protected))
    return decisions


# --------------------------------------------------------------------------- #
# Исполнение
# --------------------------------------------------------------------------- #

def open_pidfd(pid: int) -> int | None:
    try:
        return os.pidfd_open(pid)
    except (AttributeError, OSError):
        return None


def send_signal(pid: int, pidfd: int | None, sig: int) -> bool:
    try:
        if pidfd is not None:
            signal.pidfd_send_signal(pidfd, sig)
        else:
            os.kill(pid, sig)
        return True
    except (ProcessLookupError, OSError) as exc:
        if isinstance(exc, OSError) and exc.errno == errno.ESRCH:
            return False
        return False


def still_same(pid: int, starttime: int) -> bool:
    """Тот ли это процесс? Зомби (умер, но не подобран) — уже не процесс."""
    st = read_proc_stat(pid)
    return (st is not None and st["starttime"] == starttime
            and st["state"] != "Z")


def execute(decisions: list[Decision], state: dict[str, Any], now: float,
            cfg: dict[str, Any], dry_run: bool) -> list[dict[str, Any]]:
    """Убивает подтверждённых кандидатов. Возвращает отчёт о действиях."""
    report: list[dict[str, Any]] = []
    to_kill = [d for d in decisions if d.kill]
    if not to_kill:
        return report

    # Защита Kotlin-демонов, если где-то идёт сборка Gradle.
    gradle_building = any(d.daemon.kind == "gradle" and d.daemon.build_in_progress
                          for d in decisions)
    if gradle_building:
        blocked = [d for d in to_kill if d.daemon.kind == "kotlin"]
        for d in blocked:
            report.append({"pid": d.daemon.pid, "action": "skipped",
                           "reason": "идёт сборка Gradle — Kotlin-демоны не трогаю"})
        to_kill = [d for d in to_kill if d.daemon.kind != "kotlin"]

    # Порядок: сначала Gradle (их shutdown-hook чистит маркеры клиентов).
    to_kill.sort(key=lambda d: 0 if d.daemon.kind == "gradle" else 1)

    handles: dict[int, int | None] = {}
    confirmed: list[Decision] = []
    for dec in to_kill:
        d = dec.daemon
        if not still_same(d.pid, d.starttime):
            report.append({"pid": d.pid, "action": "skipped", "reason": "PID переиспользован"})
            continue
        pidfd = open_pidfd(d.pid)
        if pidfd is not None and not still_same(d.pid, d.starttime):
            report.append({"pid": d.pid, "action": "skipped", "reason": "PID переиспользован"})
            continue
        handles[d.pid] = pidfd
        confirmed.append(dec)

    if dry_run:
        for dec in confirmed:
            report.append({"pid": dec.daemon.pid, "action": "dry-run",
                           "reason": dec.reason})
        for pid, pidfd in handles.items():
            if pidfd is not None:
                os.close(pidfd)
        return report

    for dec in confirmed:
        ok = send_signal(dec.daemon.pid, handles.get(dec.daemon.pid), signal.SIGTERM)
        report.append({"pid": dec.daemon.pid, "action": "SIGTERM" if ok else "SIGTERM failed",
                       "reason": dec.reason})
        rec = state["daemons"].setdefault(str(dec.daemon.pid), {})
        rec["sigterm_attempts"] = int(rec.get("sigterm_attempts", 0)) + 1

    deadline = time.time() + float(cfg["GRACE_SECONDS"])
    while time.time() < deadline:
        if not any(still_same(d.daemon.pid, d.daemon.starttime) for d in confirmed):
            break
        time.sleep(0.5)

    for dec in confirmed:
        d = dec.daemon
        if not still_same(d.pid, d.starttime):
            continue
        rec = state["daemons"].setdefault(str(d.pid), {})
        if d.kind == "kotlin":
            send_signal(d.pid, handles.get(d.pid), signal.SIGKILL)
            report.append({"pid": d.pid, "action": "SIGKILL", "reason": "не вышел за grace"})
        else:
            attempts = int(rec.get("sigterm_attempts", 0))
            if attempts >= int(cfg["GRADLE_SIGKILL_AFTER_TRIES"]):
                send_signal(d.pid, handles.get(d.pid), signal.SIGKILL)
                report.append({"pid": d.pid, "action": "SIGKILL",
                               "reason": f"{attempts} попыток SIGTERM безуспешны"})

    for pid, pidfd in handles.items():
        if pidfd is not None:
            os.close(pidfd)
    return report


# --------------------------------------------------------------------------- #
# Метрика
# --------------------------------------------------------------------------- #

def update_metric(state: dict[str, Any], decisions: list[Decision], now: float,
                  cfg: dict[str, Any]) -> dict[str, Any]:
    """Следит за судьбой «would kill»: понадобился ли демон снова в течение окна."""
    window = float(cfg["REUSE_WINDOW_SECONDS"])
    events = state.setdefault("would_kill", [])
    by_pid = {dec.daemon.pid: dec.daemon for dec in decisions}

    for ev in events:
        if ev.get("final"):
            continue
        age = now - float(ev["at"])
        pid = int(ev["pid"])
        if age > window:
            ev["final"] = True
            continue
        d = by_pid.get(pid)
        if d is None:
            continue
        if ev.get("starttime") is not None and d.starttime != ev["starttime"]:
            # PID переиспользован: это уже другой процесс, а не «тот же демон».
            continue
        act = observed_activity(d)
        if act is not None and act > float(ev["at"]):
            ev["reused"] = True

    # новые события
    known = {int(e["pid"]) for e in events}
    for dec in decisions:
        if dec.kill and dec.daemon.pid not in known:
            events.append({"pid": dec.daemon.pid, "at": now, "reused": False,
                           "final": False, "starttime": dec.daemon.starttime})

    finals = [e for e in events if e.get("final")]
    reused = sum(1 for e in finals if e.get("reused"))
    state["metric"] = {
        "events": len(finals),
        "reused": reused,
        "rate": (reused / len(finals)) if finals else 0.0,
        "pending": len([e for e in events if not e.get("final")]),
    }
    return state["metric"]


# --------------------------------------------------------------------------- #
# Отчёт
# --------------------------------------------------------------------------- #

def format_status(decisions: list[Decision], state: dict[str, Any]) -> str:
    lines = [f"{'PID':>8} {'класс':>7} {'footprint':>10} {'простой':>9}  решение / причина"]
    lines.append("-" * 96)
    for dec in sorted(decisions, key=lambda d: -d.daemon.footprint_mb):
        d = dec.daemon
        idle = f"{dec.idle_seconds / 60:.0f} мин" if dec.idle_seconds is not None else "?"
        verdict = "УБИТЬ" if dec.kill else "оставить"
        lines.append(f"{d.pid:>8} {d.kind:>7} {d.footprint_mb:>7} МБ {idle:>9}  "
                     f"{verdict}: {dec.reason}")
    total = sum(d.daemon.footprint_mb for d in decisions)
    idle_total = sum(d.daemon.footprint_mb for d in decisions if d.kill)
    lines.append("-" * 96)
    lines.append(f"всего демонов: {len(decisions)}, footprint: {total} МБ, "
                 f"под убийство: {idle_total} МБ")
    metric = state.get("metric", {})
    if metric:
        lines.append(f"метрика dry-run: событий {metric.get('events', 0)}, "
                     f"повторно нужны {metric.get('reused', 0)} "
                     f"({100 * metric.get('rate', 0):.0f} %), в ожидании {metric.get('pending', 0)}")
    return "\n".join(lines)


def canary(daemons: list[Daemon], decisions: list[Decision]) -> str | None:
    """Предупреждение: детектор молча перестал видеть демонов."""
    if daemons:
        return None
    for entry in os.listdir("/proc"):
        if not entry.isdigit():
            continue
        cmdline = proc_cmdline(int(entry))
        if "gradle" in cmdline.lower() or "kotlin" in cmdline.lower():
            if "daemon" in cmdline.lower() or "KotlinCompileDaemon" in cmdline:
                return ("ВНИМАНИЕ: кандидатов 0, но есть java-процессы со словом "
                        "gradle/kotlin — вероятно, изменился main-класс или формат логов")
    return None


# --------------------------------------------------------------------------- #
# main
# --------------------------------------------------------------------------- #

def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description="Рейпер застаревших Gradle/Kotlin-демонов")
    parser.add_argument("--dry-run", action="store_true",
                        help="только показать решения, ничего не убивать")
    parser.add_argument("--status", action="store_true",
                        help="таблица демонов с решениями (ничего не убивать)")
    parser.add_argument("--config", help="путь к конфигу")
    args = parser.parse_args(argv)

    cfg = load_config(args.config)
    state_dir = expand(cfg["STATE_DIR"])
    os.makedirs(state_dir, exist_ok=True)

    # Единственный владелец состояния: flock исключает наложение прогонов.
    lock_path = expand(cfg["LOCK_PATH"])
    lock_fh = open(lock_path, "w")
    try:
        fcntl.flock(lock_fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        print("java-reaper: другой прогон уже идёт — выхожу", flush=True)
        return 0

    now = time.time()
    state = load_state(cfg)
    daemons = collect_daemons(cfg, state)
    decisions = classify(daemons, state, now, cfg)

    print(format_status(decisions, state), flush=True)
    warn = canary(daemons, decisions)
    if warn:
        print("WARNING: " + warn, flush=True)
    if args.status:
        # --status — только чтение: состояние не трогаем.
        return 0

    report = execute(decisions, state, now, cfg, dry_run=args.dry_run)

    # Состояние: first_seen/cpu/last_activity и попытки.
    prev = state.setdefault("daemons", {})
    for dec in decisions:
        d = dec.daemon
        rec = prev.setdefault(str(d.pid), {})
        rec.setdefault("first_seen", now)
        rec["kind"] = d.kind
        rec["cpu_ticks"] = d.cpu_ticks
        rec["starttime"] = d.starttime
        rec["log_offset"] = d.log_offset
        if d.kind == "gradle":
            rec["last_build_start"] = d.last_build_start
            rec["last_build_end"] = d.last_build_end
        if dec.busy:
            # Демон реально работал (CPU/дети/свежий лог) — отсчёт простоя
            # начинается заново. Защита (peer, нет baseline) — не активность:
            # иначе демон, за которым кто-то подключён, никогда не состарится.
            rec["last_activity"] = now
        elif dec.last_activity is not None:
            rec["last_activity"] = max(rec.get("last_activity", 0.0) or 0.0, dec.last_activity)
        if dec.busy:
            rec["sigterm_attempts"] = 0
    # Забытые PID убираем.
    live_pids = {str(dec.daemon.pid) for dec in decisions}
    for key in list(prev.keys()):
        if key not in live_pids:
            prev.pop(key, None)

    update_metric(state, decisions, now, cfg)
    save_state(cfg, state)

    for item in report:
        print(f"java-reaper: pid={item['pid']} {item['action']} — {item['reason']}", flush=True)
    killed = [i for i in report if i["action"] in ("SIGTERM", "SIGKILL")]
    print(f"java-reaper: демонов {len(decisions)}, сигналов отправлено {len(killed)}, "
          f"кандидатов на убийство {sum(1 for d in decisions if d.kill)}", flush=True)
    return 0


if __name__ == "__main__":
    sys.exit(main())
